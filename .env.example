# Client portal — server-side environment variables.
# Set these in Vercel (Project → Settings → Environment Variables).
# Never commit real values. Never prefix these with VITE_ (that would expose them to the browser).

# Harvest API v2 (see docs/CLIENT_PORTAL.md for how to find each value)
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=
HARVEST_CLIENT_ID=

# Portal login (single client account)
CLIENT_LOGIN_EMAIL=
# Generate with: node scripts/hash-portal-password.mjs "the-password"
CLIENT_PASSWORD_HASH=

# Session signing secret — any long random string, e.g.: openssl rand -hex 32
SESSION_SECRET=
