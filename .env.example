# Client portal — server-side environment variables.
# Set these in Vercel (Project → Settings → Environment Variables).
# Never commit real values. Never prefix these with VITE_ (that would expose them to the browser).

# Harvest API v2 (see docs/CLIENT_PORTAL.md for how to find each value)
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=
HARVEST_CLIENT_ID=

# Portal login (single client account)
CLIENT_LOGIN_EMAIL=
# Generate with: node scripts/hash-portal-password.mjs "the-password"
CLIENT_PASSWORD_HASH=

# Exabeam portal login — locked to Exabeam's Harvest client ID.
EXABEAM_LOGIN_EMAIL=
# Generate with: node scripts/hash-portal-password.mjs "the-password"
EXABEAM_PASSWORD_HASH=
EXABEAM_HARVEST_CLIENT_ID=
# Optional: hide Exabeam time tracked before this date (YYYY-MM-DD).
EXABEAM_EARLIEST_DATE=

# Admin login (Michelle) — can view ANY client's portal via a client switcher.
# Optional: leave blank to disable the admin login entirely.
ADMIN_LOGIN_EMAIL=
# Generate with: node scripts/hash-portal-password.mjs "the-password"
ADMIN_PASSWORD_HASH=

# Session signing secret — any long random string, e.g.: openssl rand -hex 32
SESSION_SECRET=

# Optional: hide time tracked before this date (YYYY-MM-DD) — e.g. the date the
# hourly arrangement started, so fixed-price-era hours never appear as uninvoiced.
PORTAL_EARLIEST_DATE=
